rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Deletion markers: UID-keyed startedAt timestamp only; retained to deny stale tokens.
    // users/{uid}: private blocks (createdAt), reports (bounded metadata), preferences (terms consent).
    function canWrite() {
      return isSignedIn() && !exists(/databases/$(database)/documents/accountDeletions/$(request.auth.uid));
    }
    function acceptedTerms() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)/preferences/community).data.termsVersion == '2026-11-13';
    }
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // A join/split round trip preserves a list only when every item is text.
    // U+001F is reserved as the separator (not accepted inside list items).
    // This validates every item without exceeding the rules expression budget.
    function isStringList(values, limit) {
      return values is list && values.size() <= limit &&
             (values.size() == 0 || (values.join('\u001F').size() <= 15000 && values.join('\u001F').split('\u001F') == values));
    }

    function isValidIdea(data) {
      return data.keys().hasOnly([
               'userId', 'authorName', 'title', 'description', 'category', 'tags',
               'priority', 'matrixQuadrant', 'isPublic', 'collaborators',
               'aiResearchSummary', 'aiActionPlan', 'aiMarketplaceKeywords',
               'aiMarketplaceItems', 'createdAt', 'updatedAt'
             ]) && data.userId is string && data.userId.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
             (!('authorName' in data) || (data.authorName is string && data.authorName.size() <= 100)) &&
             (!('description' in data) || (data.description is string && data.description.size() <= 10000)) &&
             (!('category' in data) || (data.category is string && data.category.size() <= 60)) &&
             (!('priority' in data) || (data.priority in ['High', 'Medium', 'Low'])) &&
             (!('matrixQuadrant' in data) || (data.matrixQuadrant in ['do_first', 'schedule', 'delegate', 'eliminate'])) &&
             (!('isPublic' in data) || data.isPublic is bool) &&
             (!('tags' in data) || isStringList(data.tags, 30)) &&
             (!('collaborators' in data) || isStringList(data.collaborators, 30)) &&
             (!('aiResearchSummary' in data) || (data.aiResearchSummary is string && data.aiResearchSummary.size() <= 15000)) &&
             (!('aiActionPlan' in data) || isStringList(data.aiActionPlan, 50)) &&
             (!('aiMarketplaceKeywords' in data) || isStringList(data.aiMarketplaceKeywords, 50)) &&
             (!('aiMarketplaceItems' in data) || (data.aiMarketplaceItems is string && data.aiMarketplaceItems.size() <= 25000));
    }

    function isValidComment(data, ideaId) {
      return data.keys().hasOnly(['ideaId', 'userId', 'userName', 'content', 'createdAt']) &&
             data.ideaId == ideaId &&
             data.userId == request.auth.uid &&
             data.content is string && data.content.size() >= 1 && data.content.size() <= 2000 &&
             (!('userName' in data) || (data.userName is string && data.userName.size() <= 100));
    }

    match /ideas/{ideaId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.isPublic == true);
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.isPublic == true);

      allow create: if canWrite() &&
                       (!('isPublic' in request.resource.data) || !request.resource.data.isPublic || acceptedTerms()) &&
                       isValidId(ideaId) &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.keys().hasAll(['userId', 'title', 'createdAt', 'updatedAt']) &&
                       request.resource.data.createdAt is timestamp &&
                       request.resource.data.createdAt <= request.time &&
                       request.resource.data.updatedAt is timestamp &&
                       request.resource.data.updatedAt <= request.time &&
                       isValidIdea(request.resource.data);

      allow update: if canWrite() &&
                       (!('isPublic' in request.resource.data) || !request.resource.data.isPublic || acceptedTerms()) &&
                       isValidId(ideaId) &&
                       resource.data.userId == request.auth.uid &&
                       request.resource.data.userId == resource.data.userId &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       request.resource.data.updatedAt is timestamp &&
                       request.resource.data.updatedAt <= request.time &&
                       isValidIdea(request.resource.data) &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'title', 'description', 'category', 'tags', 'priority', 'matrixQuadrant',
                         'isPublic', 'collaborators', 'aiResearchSummary', 'aiActionPlan',
                         'aiMarketplaceKeywords', 'aiMarketplaceItems', 'authorName', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() &&
                       isValidId(ideaId) &&
                       resource.data.userId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if isSignedIn() &&
                       (get(/databases/$(database)/documents/ideas/$(ideaId)).data.userId == request.auth.uid ||
                        get(/databases/$(database)/documents/ideas/$(ideaId)).data.isPublic == true);

        allow create: if canWrite() && acceptedTerms() &&
                         !exists(/databases/$(database)/documents/accountDeletions/$(get(/databases/$(database)/documents/ideas/$(ideaId)).data.userId)) &&
                         !exists(/databases/$(database)/documents/users/$(get(/databases/$(database)/documents/ideas/$(ideaId)).data.userId)/blocks/$(request.auth.uid)) &&
                         !exists(/databases/$(database)/documents/users/$(request.auth.uid)/blocks/$(get(/databases/$(database)/documents/ideas/$(ideaId)).data.userId)) &&
                         isValidId(commentId) &&
                         (get(/databases/$(database)/documents/ideas/$(ideaId)).data.userId == request.auth.uid ||
                          get(/databases/$(database)/documents/ideas/$(ideaId)).data.isPublic == true) &&
                         request.resource.data.userId == request.auth.uid &&
                         request.resource.data.createdAt is timestamp &&
                         request.resource.data.createdAt <= request.time &&
                         isValidComment(request.resource.data, ideaId);

        allow delete: if isSignedIn() &&
                         isValidId(commentId) &&
                         (resource.data.userId == request.auth.uid ||
                          get(/databases/$(database)/documents/ideas/$(ideaId)).data.userId == request.auth.uid);

        allow update: if false;
      }
    }

    // Collection-group cleanup is owner-only, including orphaned/private-parent comments.
    match /{path=**}/comments/{commentId} {
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /accountDeletions/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn() && request.auth.uid == uid &&
        request.auth.token.auth_time >= request.time.toMillis() / 1000 - 300 &&
        request.resource.data.keys().hasOnly(['startedAt']) &&
        request.resource.data.startedAt == request.time;
      allow list, update, delete: if false;
    }

    function isValidBlock(data) {
      return data.keys().hasOnly(['createdAt']) && data.createdAt == request.time;
    }
    function isValidConsent(data) {
      return data.keys().hasOnly(['termsVersion', 'acceptedAt']) &&
        data.termsVersion == '2026-11-13' && data.acceptedAt == request.time;
    }
    function isValidReport(data) {
      return data.keys().hasOnly(['kind','ideaId','commentId','reason','details','createdAt']) &&
        data.kind in ['idea','comment','ai'] && isValidId(data.ideaId) &&
        data.commentId is string && data.commentId.size() <= 128 &&
        ((data.kind == 'comment' && isValidId(data.commentId)) || (data.kind != 'comment' && data.commentId == '')) &&
        data.reason in ['Unsafe or illegal','Harassment or hate','Sexual content','Spam or misleading','Other'] &&
        data.details is string && data.details.size() <= 2000 && data.createdAt == request.time;
    }
    match /users/{uid}/blocks/{blockedUid} {
      allow read, delete: if isSignedIn() && request.auth.uid == uid;
      allow create, update: if canWrite() && request.auth.uid == uid &&
        isValidId(blockedUid) && blockedUid != uid && isValidBlock(request.resource.data);
    }
    match /users/{uid}/preferences/{preferenceId} {
      allow read, delete: if isSignedIn() && request.auth.uid == uid;
      allow create, update: if canWrite() && request.auth.uid == uid &&
        preferenceId == 'community' && isValidConsent(request.resource.data);
    }
    match /users/{uid}/reports/{reportId} {
      allow read, delete: if isSignedIn() && request.auth.uid == uid;
      allow create: if canWrite() && request.auth.uid == uid && isValidId(reportId) &&
        isValidReport(request.resource.data) &&
        (get(/databases/$(database)/documents/ideas/$(request.resource.data.ideaId)).data.userId == uid ||
         get(/databases/$(database)/documents/ideas/$(request.resource.data.ideaId)).data.isPublic == true);
      allow update: if false;
    }

  }
}
